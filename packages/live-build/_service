<services>
  <!--
    Co-packaged dependency (repo policy: "Dependencies not present in the
    distribution should also be added to this repo as additional packages").

    Ubuntu 22.04 and 24.04 ship live-build 3.0~a57, an unmaintained fork that
    cannot build a current image (it references boot-splash theme packages from
    Ubuntu 11.10 and rejects modern lb flags). create-network-tshoot-livecd
    needs a current live-build, so we rebuild Debian's exact source here for the
    Debian/Ubuntu targets. The epoch (1:) keeps it ahead of Ubuntu's 3.0~a57.
  -->
  <service name="download_url">
    <param name="protocol">http</param>
    <param name="host">deb.debian.org</param>
    <param name="path">/debian/pool/main/l/live-build/live-build_20250505+deb13u1.tar.xz</param>
    <param name="filename">live-build_20250505+deb13u1.tar.xz</param>
  </service>
</services>
