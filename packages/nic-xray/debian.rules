#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	# nothing to build

override_dh_auto_install:
	install -D -m 0755 nic-xray.sh \
		debian/nic-xray/usr/bin/nic-xray
	install -D -m 0644 man/man8/nic-xray.8 \
		debian/nic-xray/usr/share/man/man8/nic-xray.8
	install -D -m 0644 completions/nic-xray.bash \
		debian/nic-xray/usr/share/bash-completion/completions/nic-xray
	install -D -m 0755 nic-health.sh \
		debian/nic-xray/usr/bin/nic-health
	install -D -m 0644 man/man8/nic-health.8 \
		debian/nic-xray/usr/share/man/man8/nic-health.8
	install -D -m 0644 completions/nic-health.bash \
		debian/nic-xray/usr/share/bash-completion/completions/nic-health
